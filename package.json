{
  "name": "daybreak",
  "version": "0.1.0",
  "private": true,
  "description": "Daybreak: free analytics for Zora creator coins. Holder churn, volume patterns, and creators whose audience hasn't found their coin yet.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx scripts/collect.ts",
    "prune": "tsx scripts/prune.ts",
    "serve": "python3 -m http.server 8099 --directory out"
  },
  "dependencies": {
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@zoralabs/coins-sdk": "^0.8.0",
